# ==========================================
# Configuración de Red y Servidor
# ==========================================
# En Render, PORT se asigna dinámicamente. HOST debe ser 0.0.0.0
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ==========================================
# Integraciones de Inteligencia Artificial
# ==========================================
# Clave de API de Google Gemini para análisis cualitativo estructurado de Earnings Calls y Guidance
# (Opcional en desarrollo: si se omite, el sistema utiliza el motor semántico de contingencia)
GEMINI_API_KEY=

# ==========================================
# Integraciones Financieras Externas
# ==========================================
# Clave de API Financiera Centralizada (Financial Modeling Prep / Alpha Vantage / SEC EDGAR)
# (Opcional: si se omite, el sistema opera con el dataset seed cuantitativo de 50 CEDEARs BYMA)
FINANCIAL_API_KEY=
